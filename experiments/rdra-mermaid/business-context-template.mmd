---
title: RDRA Business Context Diagram
config:
  layout: elk
  look: handDrawn
  theme: neutral
  flowchart:
    curve: basis
    htmlLabels: false
    nodeSpacing: 48
    rankSpacing: 72
    padding: 8
  elk:
    mergeEdges: false
    nodePlacementStrategy: BRANDES_KOEPF
  themeVariables:
    background: "#F7F5F2"
    lineColor: "#666666"
    fontFamily: "Inter, Hiragino Sans, sans-serif"
    fontSize: "14px"
---

flowchart TB
  %% Prefix Rules:
  %% a_=actor, b_=business, bc_=business use case, ac_=activity, uc_=use case
  %% i_=information, r_=requirement, v_=view, e_=event, t_=timer
  %% st_=state, c_=condition, vr_=variation, s_=system, x_=external system
  %% fr_=functional requirement, nfr_=non functional requirement
  %%
  %% Icon Rules:
  %% Use Iconify MDI URLs: https://api.iconify.design/mdi/{icon}.svg
  %%
  %% Diagram Rules:
  %% - Use flowchart TB.
  %% - Use only undirected relationship lines.
  %% - Put labels at bottom with pos: "b".
  %% - Keep image node properties on one line in this order: img, label, pos, w, h, constraint.
  %% - Prefix means semantics. classDef means presentation.

  a_actor@{ img: "https://api.iconify.design/mdi/person.svg", label: "関係者", pos: "b", w: 60, h: 60, constraint: "on" }
  b_business@{ img: "https://api.iconify.design/mdi/work.svg", label: "業務", pos: "b", w: 60, h: 60, constraint: "on" }
  i_information@{ img: "https://api.iconify.design/mdi/data.svg", label: "情報", pos: "b", w: 60, h: 60, constraint: "on" }
  s_system@{ img: "https://api.iconify.design/mdi/server.svg", label: "システム", pos: "b", w: 60, h: 60, constraint: "on" }
  x_externalSystem@{ img: "https://api.iconify.design/mdi/server-network.svg", label: "外部システム", pos: "b", w: 60, h: 60, constraint: "on" }

  a_actor --- b_business
  b_business --- i_information
  b_business --- s_system
  s_system --- x_externalSystem

  classDef actor fill:none,stroke:none,color:#222222;
  classDef business fill:none,stroke:none,color:#222222;
  classDef information fill:none,stroke:none,color:#444444;
  classDef requirement fill:none,stroke:none,color:#444444;
  classDef system fill:none,stroke:none,color:#222222;
  classDef external fill:none,stroke:none,color:#666666;

  class a_actor actor;
  class b_business business;
  class i_information information;
  class s_system system;
  class x_externalSystem external;
